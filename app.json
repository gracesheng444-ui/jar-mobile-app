{
  "expo": {
    "name": "jar-mobile-app",
    "slug": "jar-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mmzhu44.jarmobileapp",
      "adaptiveIcon": {
        "backgroundColor": "#FDF6EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Shared Memory Jar uses your photos to let you pick a profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8943acdf-59ff-4cd2-99df-42659d198b13"
      }
    },
    "owner": "mmzhu_44"
  }
}
